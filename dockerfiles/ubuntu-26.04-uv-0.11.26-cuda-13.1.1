FROM nvidia/cuda:13.3.0-devel-ubuntu26.04
ENV DEBIAN_FRONTEND=noninteractive
# Copyied from the official Astral uv page about Docker images available at:
# https://docs.astral.sh/uv/guides/integration/docker/#installing-uv
# Modified to install uv at /usr/local/bin.
COPY --from=ghcr.io/astral-sh/uv:0.11.26 /uv /uvx /usr/local/bin/
LABEL maintainer="Joao Aguirre <aguirre.eng@gmail.com>"

# Install Linux tools & uv dependencies. Here there are also system dependencies
# for NVIDIA CUDA, OptiX, and Newton tools.
RUN apt-get update && \
    apt-get install --assume-yes --no-install-recommends \
        ca-certificates curl zip unzip tar git git-lfs pkg-config \
        build-essential cmake ninja-build \
        libx11-dev libxcursor-dev libxi-dev libxinerama-dev libxrandr-dev \
        libx11-6 libgl1 libglx0 libegl1 libgles2 \
        libglx-mesa0 libgl1-mesa-dev libgl1-mesa-dri \
        freeglut3-dev mesa-common-dev mesa-utils xvfb \
        libxft2 libxrender1 libxext6 libxcursor1 libxinerama1 \
        tmux bat fzf ripgrep fd-find && \
    rm -rf /var/lib/apt/lists/*

# Create configuration folders for user ubuntu (avoids the issue with top level
# `.config` and `.local` folders being owned by the `root` user.
RUN mkdir --parents \
    /home/ubuntu/.config \
    /home/ubuntu/.local/share \
    && chown -R ubuntu:ubuntu \
    /home/ubuntu/.config \
    /home/ubuntu/.local

# Set the default workspace folder and shell.
WORKDIR /workspaces
CMD ["/bin/bash"]
