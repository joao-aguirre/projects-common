FROM nvidia/cuda:13.1.0-devel-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive
# Copyied from the official Astral uv page about Docker images available at:
# https://docs.astral.sh/uv/guides/integration/docker/#installing-uv
# Modified to install uv at /usr/local/bin.
COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /usr/local/bin/
LABEL maintainer="Joao Aguirre <aguirre.eng@gmail.com>"

# Install Linux tools & uv dependencies.
RUN apt-get update && \
    apt-get install --assume-yes --no-install-recommends \
        ca-certificates curl zip unzip tar git git-lfs pkg-config \
        build-essential cmake ninja-build python3 python3-pip \
        libx11-dev libxcursor-dev libxi-dev libxinerama-dev libxrandr-dev \
        mesa-common-dev sudo && \
    rm -rf /var/lib/apt/lists/*
# Grant the default user `ubuntu` `sudo` permissions.
RUN echo "ubuntu ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/ubuntu && \
    chmod 0440 /etc/sudoers.d/ubuntu

# Install NVIDIA OptiX SDK and OptiX Toolkit
RUN git clone --depth=1 https://github.com/NVIDIA/optix-dev.git /opt/optix-dev && \
    git clone --depth=1 https://github.com/NVIDIA/optix-toolkit /opt/optix-toolkit
RUN git clone --depth=1 https://github.com/microsoft/vcpkg.git /opt/vcpkg && \
    /opt/vcpkg/bootstrap-vcpkg.sh

# Set environment variables.
ENV VCPKG_ROOT=/opt/vcpkg
ENV OPTIX_DEV=/opt/optix-dev
ENV PATH=/usr/local/bin:${VCPKG_ROOT}:${PATH}
ENV CPATH=${OPTIX_DEV}/include:${CPATH}

# Set the default workspace folder and shell.
WORKDIR /workspaces
CMD ["/bin/bash"]
